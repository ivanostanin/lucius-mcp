# Allure TestOps Configuration
ALLURE_ENDPOINT=https://demo.testops.cloud
ALLURE_PROJECT_ID=000
ALLURE_API_TOKEN=your_token_here

# Application Configuration
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
MCP_MODE=stdio
# Maximum decoded/downloaded size of one uploaded attachment in bytes (10 MiB)
ATTACHMENT_MAX_FILE_BYTES=10485760
